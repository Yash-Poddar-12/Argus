{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/contracts/events/m00/_defs.json",
  "title": "M00 master-data entities",
  "$defs": {
    "Site": {
      "type": "object",
      "required": [
        "site_id",
        "name",
        "status"
      ],
      "properties": {
        "site_id": {
          "$ref": "https://argus.local/contracts/schemas/common/ids.json#/$defs/SiteId"
        },
        "name": {
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "https://argus.local/contracts/schemas/common/geo.json#/$defs/GeoPoint"
            },
            {
              "type": "null"
            }
          ]
        },
        "timezone": {
          "type": "string"
        },
        "configuration": {
          "type": "object"
        },
        "status": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "INACTIVE",
            "MAINTENANCE",
            "RETIRED"
          ]
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "Zone": {
      "type": "object",
      "required": [
        "zone_id",
        "site_id",
        "name",
        "zone_type",
        "geometry",
        "status"
      ],
      "properties": {
        "zone_id": {
          "$ref": "https://argus.local/contracts/schemas/common/ids.json#/$defs/ZoneId"
        },
        "site_id": {
          "$ref": "https://argus.local/contracts/schemas/common/ids.json#/$defs/SiteId"
        },
        "name": {
          "type": "string"
        },
        "zone_type": {
          "enum": [
            "TASK",
            "HAZARD",
            "RESTRICTED",
            "DISPOSAL",
            "SOFT_GROUND",
            "OTHER"
          ]
        },
        "geometry": {
          "$ref": "https://argus.local/contracts/schemas/common/geo.json#/$defs/Polygon"
        },
        "status": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "INACTIVE",
            "MAINTENANCE",
            "RETIRED"
          ]
        }
      }
    },
    "Operator": {
      "type": "object",
      "required": [
        "operator_id",
        "name",
        "site_id",
        "experience_level",
        "certification_status",
        "status"
      ],
      "properties": {
        "operator_id": {
          "$ref": "https://argus.local/contracts/schemas/common/ids.json#/$defs/OperatorId"
        },
        "name": {
          "type": "string"
        },
        "site_id": {
          "$ref": "https://argus.local/contracts/schemas/common/ids.json#/$defs/SiteId"
        },
        "experience_level": {
          "enum": [
            "JUNIOR",
            "INTERMEDIATE",
            "SENIOR"
          ]
        },
        "certification_status": {
          "enum": [
            "VALID",
            "EXPIRING",
            "EXPIRED"
          ]
        },
        "preferred_language": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "INACTIVE",
            "MAINTENANCE",
            "RETIRED"
          ]
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "Machine": {
      "type": "object",
      "required": [
        "machine_id",
        "site_id",
        "machine_type",
        "model",
        "serial_number",
        "engine_hours",
        "status"
      ],
      "properties": {
        "machine_id": {
          "$ref": "https://argus.local/contracts/schemas/common/ids.json#/$defs/MachineId"
        },
        "site_id": {
          "$ref": "https://argus.local/contracts/schemas/common/ids.json#/$defs/SiteId"
        },
        "machine_type": {
          "enum": [
            "EXCAVATOR",
            "DUMPER",
            "LOADER",
            "DOZER",
            "OTHER"
          ]
        },
        "model": {
          "type": "string"
        },
        "serial_number": {
          "type": "string"
        },
        "engine_hours": {
          "type": "number",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "INACTIVE",
            "MAINTENANCE",
            "RETIRED"
          ]
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}
