# Platform settings (M00). Module settings live in infra/env/<module>.env.example with a module prefix.
# `python scripts/dev.py env` concatenates all examples into .env (gitignored). Never commit real secrets.

APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=true

# Docker Compose (make up / dev.py up)
POSTGRES_USER=argus
POSTGRES_PASSWORD=argus-dev-password
POSTGRES_DB=argus
DATABASE_URL=postgresql+asyncpg://argus:argus-dev-password@db:5432/argus
DB_AUTO_CREATE=false
REDIS_URL=redis://redis:6379/0
EVENT_BUS=redis

# Auth: replace in any shared environment
JWT_SECRET=dev-only-change-me-dev-only-change-me
JWT_TTL_MINUTES=720
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
