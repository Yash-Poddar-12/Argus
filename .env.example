# Copy to .env (gitignored) for Docker Compose: `cp .env.example .env` (or `python scripts/dev.py env`).
# Lite mode (`python scripts/dev.py api`) needs no .env. Never commit real secrets.
# Capability-specific settings go in their own section below, prefixed by capability (e.g. COPILOT_*, IOT_*).

# ---- platform ----
APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=true

# ---- database / cache / events (Docker Compose values) ----
POSTGRES_USER=argus
POSTGRES_PASSWORD=argus-dev-password
POSTGRES_DB=argus
DATABASE_URL=postgresql+asyncpg://argus:argus-dev-password@db:5432/argus
DB_AUTO_CREATE=false
REDIS_URL=redis://redis:6379/0
EVENT_BUS=redis

# ---- auth: replace in any shared environment ----
JWT_SECRET=dev-only-change-me-dev-only-change-me
JWT_TTL_MINUTES=720
CORS_ORIGINS=["http://localhost:3000"]

# ---- frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
